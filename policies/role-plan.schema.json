{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/role-plan.v0.2.json",
  "title": "Agent Company Role Plan",
  "description": "One role's local how, bound to exactly one immutable company assignment and leaf.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "role_plan_id",
    "company_plan_id",
    "company_plan_ref",
    "company_plan_sha256",
    "assignment_id",
    "leaf_id",
    "role",
    "inputs",
    "local_approach",
    "read_scope",
    "write_scope",
    "outputs",
    "role_local_qa",
    "escalation_triggers",
    "forbidden_mutations",
    "execution_receipt_binding"
  ],
  "properties": {
    "format": {"const": "agent-company.role-plan/v0.2"},
    "role_plan_id": {"type": "string", "minLength": 1},
    "company_plan_id": {"type": "string", "minLength": 1},
    "company_plan_ref": {"type": "string", "minLength": 1},
    "company_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assignment_id": {"type": "string", "minLength": 1},
    "leaf_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["founder", "planning", "marketing", "design", "development", "qa-release"]},
    "operating_contract_ref": {
      "type": "string",
      "minLength": 1
    },
    "operating_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputs": {"$ref": "#/$defs/nonEmptyStrings"},
    "local_approach": {"$ref": "#/$defs/nonEmptyStrings"},
    "read_scope": {"$ref": "#/$defs/nonEmptyStrings"},
    "write_scope": {"$ref": "#/$defs/nonEmptyStrings"},
    "outputs": {"$ref": "#/$defs/nonEmptyStrings"},
    "qa_verification": {"$ref": "#/$defs/qaAssignmentVerification"},
    "role_local_qa": {"$ref": "#/$defs/nonEmptyStrings"},
    "escalation_triggers": {"$ref": "#/$defs/nonEmptyStrings"},
    "forbidden_mutations": {
      "allOf": [
        {"$ref": "#/$defs/nonEmptyStrings"},
        {"contains": {"const": "uigwe_scope"}},
        {"contains": {"const": "company_success_criteria"}},
        {"contains": {"const": "company_stop_criteria"}},
        {"contains": {"const": "dependency_dag"}},
        {"contains": {"const": "other_assignments"}},
        {"contains": {"const": "sejong_synthesis"}},
        {"contains": {"const": "verification_authority"}}
      ]
    },
    "execution_receipt_binding": {"$ref": "#/$defs/executionReceiptBinding"}
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "marketing"}}, "required": ["role"]},
      "then": {
        "required": ["operating_contract_ref", "operating_contract_sha256"],
        "properties": {
          "operating_contract_ref": {"const": "skills/marketing-operating-system/references/marketing-contract.json"},
          "operating_contract_sha256": {"const": "df11697e644b07fefaab4d3c22f69f2d1c137c01de31234f206f50b8f3859683"}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "design"}}, "required": ["role"]},
      "then": {
        "required": ["operating_contract_ref", "operating_contract_sha256"],
        "properties": {
          "operating_contract_ref": {"const": "skills/design-operating-system/references/design-contract.json"},
          "operating_contract_sha256": {"const": "3aa171624548925032ed22628f77a7720ca4a2bb89f38c5a9babcf32b24c0702"}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "development"}}, "required": ["role"]},
      "then": {
        "required": ["operating_contract_ref", "operating_contract_sha256"],
        "properties": {
          "operating_contract_ref": {"const": "skills/development-operating-system/references/development-contract.json"},
          "operating_contract_sha256": {"const": "1efa017b894f6c5d908d5904adb6a8fe9f824e6839f8a9941894dcbc772ed2ff"}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "qa-release"}}, "required": ["role"]},
      "then": {
        "required": ["operating_contract_ref", "operating_contract_sha256", "qa_verification"],
        "properties": {
          "operating_contract_ref": {"const": "skills/qa-release-operating-system/references/qa-release-contract.json"},
          "operating_contract_sha256": {"const": "1d28cb70df55b058244d3995997fbea37a262775539e4bfcacc66a21b7743f23"}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "founder"}}, "required": ["role"]},
      "then": {
        "required": ["operating_contract_ref", "operating_contract_sha256"],
        "properties": {
          "operating_contract_ref": {"const": "skills/founder-operating-system/references/founder-contract.json"},
          "operating_contract_sha256": {"const": "b0aa74ed14ad41072adf01e700028ba185b052fd29e7c9a613b5ba265f7fffc7"}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "planning"}}, "required": ["role"]},
      "then": {
        "required": ["operating_contract_ref", "operating_contract_sha256"],
        "properties": {
          "operating_contract_ref": {"const": "skills/planning-operating-system/references/planning-contract.json"},
          "operating_contract_sha256": {"const": "e04447babbd66e65cd3d75839793ab6a544c618bef7600f66652f9cb0afce451"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "role": {
            "enum": ["founder", "planning", "marketing", "design", "development"]
          }
        },
        "required": ["role"]
      },
      "then": {"not": {"required": ["qa_verification"]}}
    }
  ],
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "qaAssignmentCandidate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["binding", "identity_ref", "identity_sha256"],
          "properties": {
            "binding": {"const": "exact"},
            "identity_ref": {"type": "string", "minLength": 1},
            "identity_sha256": {
              "type": "string",
              "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["binding", "identity_ref", "reason"],
          "properties": {
            "binding": {"const": "partial"},
            "identity_ref": {"type": "string", "minLength": 1},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["binding", "reason"],
          "properties": {
            "binding": {"const": "unknown"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "qaAssignmentCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "claim",
        "required_surface",
        "required_qualifier",
        "required_permission_states",
        "expected_observable"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["acceptance", "risk", "boundary"]},
        "claim": {"type": "string", "minLength": 1},
        "required_surface": {
          "enum": [
            "automated",
            "simulator",
            "real_device",
            "permission_lifecycle",
            "storekit",
            "app_store_connect",
            "manual"
          ]
        },
        "required_qualifier": {
          "enum": [
            "automated",
            "simulator",
            "physical_device",
            "storekit_local",
            "sandbox_account",
            "remote_account",
            "manual"
          ]
        },
        "required_permission_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "not_determined",
              "denied",
              "limited",
              "granted",
              "revoked",
              "settings_return",
              "relaunch"
            ]
          }
        },
        "expected_observable": {"type": "string", "minLength": 1}
      }
    },
    "qaAssignmentRiskBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "risk_id",
        "boundary_id",
        "impact",
        "non_substitute_surface"
      ],
      "properties": {
        "criterion_id": {"type": "string", "minLength": 1},
        "risk_id": {"type": "string", "minLength": 1},
        "boundary_id": {"type": "string", "minLength": 1},
        "impact": {"enum": ["low", "medium", "high", "critical"]},
        "non_substitute_surface": {"type": "string", "minLength": 1}
      }
    },
    "qaAssignmentVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "candidate",
        "references",
        "criteria",
        "observations",
        "evidence_facts",
        "risk_boundary_matrix",
        "decisions",
        "blockers",
        "readiness"
      ],
      "properties": {
        "format": {"const": "agent-company.qa-verification/v0.2"},
        "candidate": {"$ref": "#/$defs/qaAssignmentCandidate"},
        "references": {"type": "array", "maxItems": 32},
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/qaAssignmentCriterion"}
        },
        "observations": {"type": "array", "maxItems": 20},
        "evidence_facts": {"type": "array", "maxItems": 20},
        "risk_boundary_matrix": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/qaAssignmentRiskBoundary"}
        },
        "decisions": {"type": "array", "minItems": 1, "maxItems": 8},
        "blockers": {"type": "array", "maxItems": 20},
        "readiness": {"type": "object"}
      }
    },
    "executionReceiptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "receipt_id", "role_plan_id", "assignment_id", "role"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^\\$\\{SEJONG_HOME\\}/runs/agent-company/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))[A-Za-z0-9._-]+/.+"
        },
        "receipt_id": {"type": "string", "minLength": 1},
        "role_plan_id": {"type": "string", "minLength": 1},
        "assignment_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["founder", "planning", "marketing", "design", "development", "qa-release"]}
      }
    }
  }
}
