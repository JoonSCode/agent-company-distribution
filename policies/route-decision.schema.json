{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/route-decision.v0.2.json",
  "title": "Agent Company Core-backed Route Decision",
  "description": "An immutable projection of a King Sejong Core route into zero or more ordinary Agent Company roles. It never scores a route or selects a worker backend.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "status",
    "lane",
    "selected_route",
    "ordinary_role_ids"
  ],
  "properties": {
    "format": {"const": "agent-company.route-decision/v0.2"},
    "status": {"enum": ["accepted", "rejected"]},
    "lane": {"enum": ["direct", "inactive", "role", "squad", "reject"]},
    "selected_route": {"type": "string", "minLength": 1, "readOnly": true},
    "capability_refs": {"$ref": "#/$defs/refs", "readOnly": true},
    "gate_refs": {"$ref": "#/$defs/refs", "readOnly": true},
    "evidence_refs": {"$ref": "#/$defs/refs", "readOnly": true},
    "recommended_reentry_target": {"type": "string", "minLength": 1, "readOnly": true},
    "ordinary_role_ids": {
      "type": "array",
      "uniqueItems": true,
      "readOnly": true,
      "items": {
        "enum": ["founder", "planning", "design", "development", "marketing", "qa-release"]
      }
    },
    "core_continues": {"const": true},
    "core_authority_sha256": {"$ref": "#/$defs/sha256", "readOnly": true},
    "core_source_ref": {"type": "string", "format": "uri", "pattern": "^file://", "readOnly": true},
    "core_source_sha256": {"$ref": "#/$defs/sha256", "readOnly": true},
    "staffing_sha256": {"$ref": "#/$defs/sha256", "readOnly": true},
    "backend_provenance": {
      "type": "object",
      "minProperties": 1,
      "readOnly": true,
      "additionalProperties": true
    },
    "approval_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_ref", "receipt_sha256", "action_id", "source_user_decision_ref"],
      "properties": {
        "receipt_ref": {"type": "string", "minLength": 1},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "action_id": {"type": "string", "minLength": 1},
        "source_user_decision_ref": {"type": "string", "minLength": 1}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skips",
        "retained_gates",
        "ordinary_staffing",
        "auxiliary_specialist_separate",
        "external_mutation",
        "approval_required"
      ],
      "properties": {
        "skips": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["v0.1-kickoff", "squad", "company-plan"]}
        },
        "retained_gates": {
          "const": [
            "material-ambiguity",
            "external-action",
            "host-permission",
            "selected-surface-verification"
          ]
        },
        "ordinary_staffing": {"enum": ["none", "one", "two-or-more"]},
        "auxiliary_specialist_separate": {"const": true},
        "external_mutation": {"type": "boolean"},
        "approval_required": {"type": "boolean"}
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": {
          "enum": [
            "approval_gate_missing",
            "approval_receipt_missing",
            "backend_provenance_forged",
            "capability_evidence_missing",
            "core_format_mismatch",
            "core_gate_contradiction",
            "duplicate_core_ref",
            "invalid_approval_receipt",
            "malformed_input",
            "specialist_collision",
            "staffing_not_permitted",
            "stale_state",
            "stale_approval_receipt",
            "untrusted_path",
            "wrong_approval_decision",
            "unsupported_route"
          ]
        },
        "detail": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "acceptedBase": {
      "required": [
        "capability_refs",
        "gate_refs",
        "evidence_refs",
        "recommended_reentry_target",
        "core_continues",
        "core_authority_sha256",
        "core_source_ref",
        "core_source_sha256",
        "staffing_sha256",
        "lifecycle"
      ],
      "properties": {
        "status": {"const": "accepted"}
      },
      "not": {"required": ["rejection"]}
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/acceptedBase",
      "properties": {
        "lane": {"const": "direct"},
        "selected_route": {"const": "direct_execution"},
        "ordinary_role_ids": {"maxItems": 0},
        "lifecycle": {
          "properties": {
            "skips": {"const": ["v0.1-kickoff", "squad", "company-plan"]},
            "ordinary_staffing": {"const": "none"}
          },
          "allOf": [
            {
              "if": {
                "required": ["external_mutation"],
                "properties": {"external_mutation": {"const": true}}
              },
              "then": {"properties": {"approval_required": {"const": true}}}
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": {
                "properties": {"external_mutation": {"const": true}}
              }
            }
          },
          "then": {"required": ["approval_receipt"]},
          "else": {"not": {"required": ["approval_receipt"]}}
        }
      ]
    },
    {
      "$ref": "#/$defs/acceptedBase",
      "properties": {
        "lane": {"const": "inactive"},
        "selected_route": {
          "enum": ["bounded_subagents", "team_executor", "research_fanout", "no_write_dry_run"]
        },
        "ordinary_role_ids": {"maxItems": 0},
        "lifecycle": {"properties": {"ordinary_staffing": {"const": "none"}}}
      }
    },
    {
      "$ref": "#/$defs/acceptedBase",
      "properties": {
        "lane": {"const": "role"},
        "selected_route": {"enum": ["bounded_subagents", "team_executor"]},
        "ordinary_role_ids": {"minItems": 1, "maxItems": 1},
        "lifecycle": {"properties": {"ordinary_staffing": {"const": "one"}}}
      }
    },
    {
      "$ref": "#/$defs/acceptedBase",
      "properties": {
        "lane": {"const": "squad"},
        "selected_route": {"enum": ["bounded_subagents", "team_executor"]},
        "ordinary_role_ids": {"minItems": 2},
        "lifecycle": {"properties": {"ordinary_staffing": {"const": "two-or-more"}}}
      }
    },
    {
      "required": ["rejection"],
      "properties": {
        "status": {"const": "rejected"},
        "lane": {"const": "reject"}
      },
      "not": {
        "anyOf": [
          {"required": ["core_continues"]},
          {"required": ["lifecycle"]}
        ]
      }
    }
  ]
}
