{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/model-rate-card.v0.1.json",
  "title": "Agent Company refreshable subscription-credit model rate card",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "availability", "surface", "source", "freshness_policy", "rates"],
  "properties": {
    "format": {"const": "agent-company.model-rate-card/v0.1"},
    "availability": {"enum": ["available", "unavailable", "inapplicable"]},
    "surface": {"const": "standard_chatgpt_subscription_credit"},
    "source": {"$ref": "#/$defs/source"},
    "freshness_policy": {"$ref": "#/$defs/freshness"},
    "rates": {"type": "array", "minItems": 3, "maxItems": 4, "items": {"$ref": "#/$defs/rate"}}
  },
  "$defs": {
    "source": {"oneOf": [{"properties": {"primary_url": {"const": "https://help.openai.com/en/articles/20001106-codex-rate-card"}, "corroborating_url": {"const": "https://learn.chatgpt.com/docs/pricing"}}}, {"properties": {"primary_url": {"const": "https://learn.chatgpt.com/docs/pricing"}, "corroborating_url": {"const": null}}}], "type": "object", "additionalProperties": false, "required": ["primary_url", "corroborating_url", "source_updated_at", "observed_at", "normalized_extracted_rate_digest"], "properties": {"primary_url": {"enum": ["https://help.openai.com/en/articles/20001106-codex-rate-card", "https://learn.chatgpt.com/docs/pricing"]}, "corroborating_url": {"enum": ["https://learn.chatgpt.com/docs/pricing", null]}, "source_updated_at": {"type": ["string", "null"], "format": "date-time"}, "observed_at": {"type": "string", "format": "date-time"}, "normalized_extracted_rate_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "freshness": {"type": "object", "additionalProperties": false, "required": ["refresh_after_seconds", "hard_stale_after_seconds", "policy_label"], "properties": {"refresh_after_seconds": {"type": "integer", "minimum": 1}, "hard_stale_after_seconds": {"type": "integer", "minimum": 1}, "policy_label": {"const": "agent_company_policy"}}},
    "credits": {"type": "object", "additionalProperties": false, "required": ["input", "cached_input", "output"], "properties": {"input": {"type": "number", "exclusiveMinimum": 0}, "cached_input": {"type": "number", "exclusiveMinimum": 0}, "output": {"type": "number", "exclusiveMinimum": 0}}},
    "rate": {"type": "object", "additionalProperties": false, "required": ["model_id", "credits_per_million", "cache_write_billing", "currency_price", "provider_debited_credits", "effective_from"], "properties": {"model_id": {"enum": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.6-luna", "gpt-6-astra"]}, "credits_per_million": {"$ref": "#/$defs/credits"}, "cache_write_billing": {"enum": ["not_charged", "unknown"]}, "currency_price": {"type": ["number", "null"], "minimum": 0}, "provider_debited_credits": {"type": ["number", "null"], "minimum": 0}, "effective_from": {"type": ["string", "null"], "format": "date-time"}}}
  }
}
