{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/ceo-report.v0.1.json",
  "title": "Agent Company CEO Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "job_id",
    "job_type",
    "objective",
    "overall_status",
    "decision_summary",
    "role_deliveries",
    "external_actions",
    "claims",
    "user_decisions",
    "risks",
    "next_actions"
  ],
  "properties": {
    "format": {"const": "agent-company.ceo-report/v0.1"},
    "job_id": {"type": "string", "minLength": 1},
    "job_type": {
      "enum": ["new-app", "improvement", "planning", "promotion", "release", "incident", "portfolio"]
    },
    "objective": {"type": "string", "minLength": 1},
    "overall_status": {
      "enum": ["executed", "verified", "failed", "blocked", "unverified", "mixed"]
    },
    "decision_summary": {"type": "string", "minLength": 1},
    "role_deliveries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "worker_ref", "state", "summary", "evidence_refs"],
        "properties": {
          "role": {
            "enum": ["founder", "planning", "design", "development", "marketing", "qa-release", "specialist"]
          },
          "worker_ref": {"type": "string", "minLength": 1},
          "state": {"$ref": "#/$defs/evidenceState"},
          "summary": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "allOf": [{
          "if": {"properties": {"state": {"const": "verified"}}, "required": ["state"]},
          "then": {"properties": {"evidence_refs": {"minItems": 1}}}
        }]
      }
    },
    "external_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "action_name", "target", "state", "evidence_refs"],
        "properties": {
          "action_id": {"type": "string", "minLength": 1},
          "action_name": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "state": {"$ref": "#/$defs/evidenceState"},
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "allOf": [{
          "if": {"properties": {"state": {"const": "verified"}}, "required": ["state"]},
          "then": {"properties": {"evidence_refs": {"minItems": 1}}}
        }]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "state", "evidence_refs"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "state": {"$ref": "#/$defs/evidenceState"},
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "allOf": [{
          "if": {"properties": {"state": {"const": "verified"}}, "required": ["state"]},
          "then": {"properties": {"evidence_refs": {"minItems": 1}}}
        }]
      }
    },
    "user_decisions": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "next_actions": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [{
    "if": {
      "properties": {"overall_status": {"const": "verified"}},
      "required": ["overall_status"]
    },
    "then": {
      "properties": {
        "role_deliveries": {"items": {"properties": {"state": {"const": "verified"}}}},
        "external_actions": {"items": {"properties": {"state": {"const": "verified"}}}},
        "claims": {"items": {"properties": {"state": {"const": "verified"}}}},
        "risks": {"maxItems": 0}
      }
    }
  }],
  "$defs": {
    "evidenceState": {
      "enum": ["executed", "verified", "failed", "blocked", "unverified"]
    }
  }
}
