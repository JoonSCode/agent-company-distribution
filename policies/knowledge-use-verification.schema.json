{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/knowledge-use-verification.v0.3.json",
  "title": "Agent Company independent knowledge use verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "verification_id",
    "issuer_role",
    "issuer_ref",
    "reviews",
    "verified_at",
    "attestation_scope",
    "byte_provenance"
  ],
  "properties": {
    "format": {
      "const": "agent-company.knowledge-use-verification/v0.3"
    },
    "verification_id": {
      "$ref": "#/$defs/sha256"
    },
    "issuer_role": {
      "const": "seungjeongwon"
    },
    "issuer_ref": {
      "type": "string",
      "minLength": 1
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "attestation_scope": {
      "const": "independent_knowledge_application_review"
    },
    "byte_provenance": {
      "$ref": "#/$defs/byte_provenance"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "worker_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_id",
        "handoff_ref",
        "handoff_sha256",
        "terminal_receipt_id",
        "terminal_receipt_sha256"
      ],
      "properties": {
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "handoff_ref": {
          "type": "string",
          "minLength": 1
        },
        "handoff_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "terminal_receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "terminal_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "byte_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegation_input",
        "job",
        "core_run",
        "worker_artifacts"
      ],
      "properties": {
        "delegation_input": {
          "$ref": "#/$defs/artifact"
        },
        "job": {
          "$ref": "#/$defs/artifact"
        },
        "core_run": {
          "$ref": "#/$defs/artifact"
        },
        "worker_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/worker_artifact"
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "decision_question",
        "outcome",
        "evidence_refs"
      ],
      "properties": {
        "reference_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_question": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": ["applied", "misapplied", "unobserved"]
        },
        "evidence_refs": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_id",
        "role",
        "executor_ref",
        "reviewer_role",
        "reviewer_ref",
        "context_id",
        "knowledge_receipt_id",
        "required_reference_ids",
        "application_findings",
        "verdict"
      ],
      "properties": {
        "worker_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "founder",
            "planning",
            "marketing",
            "design",
            "development",
            "qa-release"
          ]
        },
        "executor_ref": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_role": {
          "enum": ["qa-release", "seungjeongwon"]
        },
        "reviewer_ref": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "$ref": "#/$defs/sha256"
        },
        "knowledge_receipt_id": {
          "$ref": "#/$defs/sha256"
        },
        "required_reference_ids": {
          "$ref": "#/$defs/strings"
        },
        "application_findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "verdict": {
          "enum": ["verified", "rejected", "unverified"]
        }
      }
    }
  }
}
