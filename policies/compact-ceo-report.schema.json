      "then": {
        "properties": {
          "verification": {"const": "failed"},
          "material_risks": {
            "contains": {"properties": {"state": {"const": "failed"}}, "required": ["state"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_report": {
            "properties": {"overall_status": {"const": "blocked"}},
            "required": ["overall_status"]
          }
        },
        "required": ["source_report"]
      },
      "then": {
        "properties": {
          "verification": {"const": "blocked"},
          "decision_required": {"const": true},
          "material_risks": {
            "contains": {"properties": {"state": {"const": "blocked"}}, "required": ["state"]}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_report": {
            "properties": {"overall_status": {"enum": ["unverified", "mixed"]}},
            "required": ["overall_status"]
          }
        },
        "required": ["source_report"]
      },
      "then": {
        "properties": {
          "material_risks": {
            "contains": {"properties": {"state": {"const": "unverified"}}, "required": ["state"]}
          }
        }
      }
    }
  ]
}
