{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/compact-ceo-report.v0.2.json",
  "title": "Agent Company Compact CEO Report Projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "source_report",
    "lane",
    "outcome",
    "verification",
    "decision_required",
    "decision_prompt",
    "material_risks",
    "next_action",
    "evidence_links"
  ],
  "properties": {
    "format": {"const": "agent-company.compact-ceo-report/v0.2"},
    "source_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "job_id", "ref", "sha256", "overall_status"],
      "properties": {
        "format": {"const": "agent-company.ceo-report/v0.1"},
        "job_id": {"type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "ref": {"type": "string", "pattern": "^evidence://agent-company/ceo-report/[A-Za-z0-9][A-Za-z0-9._-]*/[0-9a-f]{64}\\.json$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "overall_status": {
          "enum": ["executed", "verified", "failed", "blocked", "unverified", "mixed"]
        }
      }
    },
    "lane": {"enum": ["direct", "role", "squad"]},
    "outcome": {"$ref": "#/$defs/safeText"},
    "verification": {
      "enum": ["executed", "verified", "failed", "blocked", "unverified", "mixed"]
    },
    "decision_required": {"type": "boolean"},
    "decision_prompt": {"$ref": "#/$defs/safeText"},
    "material_risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "summary", "evidence_refs"],
        "properties": {
          "state": {"enum": ["failed", "blocked", "unverified"]},
          "summary": {"$ref": "#/$defs/safeText"},
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/evidenceRef"}
          }
        }
      }
    },
    "next_action": {"$ref": "#/$defs/safeText"},
    "evidence_links": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidenceRef"}
    }
  },
