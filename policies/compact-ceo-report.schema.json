        "properties": {"material_risks": {"maxItems": 0}},
        "required": ["material_risks"]
      },
      "then": {"properties": {"decision_required": {"const": false}}}
    },
    {
      "if": {
        "properties": {"verification": {"const": "verified"}},
        "required": ["verification"]
      },
      "then": {
        "properties": {
          "source_report": {
            "properties": {"overall_status": {"const": "verified"}}
          },
          "material_risks": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_report": {
            "properties": {"overall_status": {"const": "failed"}},
            "required": ["overall_status"]
          }
        },
        "required": ["source_report"]
