{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/knowledge-usage-receipt.v0.1.json",
  "title": "Agent Company knowledge usage receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "receipt_id",
    "context_id",
    "role",
    "task_type",
    "objective_sha256",
    "decision_questions",
    "registry_sha256",
    "manifest_sha256",
    "required_reference_ids",
    "used_references",
    "unused_reference_ids",
    "specialist_skills",
    "reported_by",
    "reported_at",
    "attestation_scope"
  ],
  "properties": {
    "format": {"const": "agent-company.knowledge-usage-receipt/v0.2"},
    "receipt_id": {"$ref": "#/$defs/sha256"},
    "context_id": {"$ref": "#/$defs/sha256"},
    "role": {"enum": ["founder", "planning", "marketing", "design", "development", "qa-release"]},
    "task_type": {"type": "string", "minLength": 1},
    "objective_sha256": {"$ref": "#/$defs/sha256"},
    "decision_questions": {"$ref": "#/$defs/strings"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "required_reference_ids": {"$ref": "#/$defs/strings"},
    "used_references": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/usedReference"}
    },
    "unused_reference_ids": {"$ref": "#/$defs/strings"},
    "specialist_skills": {"$ref": "#/$defs/strings"},
    "reported_by": {"const": "role-worker"},
    "reported_at": {"type": "string", "format": "date-time"},
    "attestation_scope": {"const": "worker_reported_use_independent_verification_required"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "usedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "ref", "sha256", "decisions_supported"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "decisions_supported": {"$ref": "#/$defs/strings"}
      }
    }
  }
}
