{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/knowledge-context.v0.2.json",
  "title": "Agent Company parent-issued knowledge context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "context_id",
    "role",
    "task_type",
    "objective_sha256",
    "decision_questions",
    "registry_sha256",
    "manifest_sha256",
    "routing_sha256",
    "required_reference_ids",
    "specialist_skills",
    "selection",
    "materialized_references",
    "issued_by",
    "issued_at",
    "attestation_scope"
  ],
  "properties": {
    "format": {"const": "agent-company.knowledge-context/v0.2"},
    "context_id": {"$ref": "#/$defs/sha256"},
    "role": {"enum": ["founder", "planning", "marketing", "design", "development", "qa-release"]},
    "task_type": {"type": "string", "minLength": 1},
    "objective_sha256": {"$ref": "#/$defs/sha256"},
    "decision_questions": {"$ref": "#/$defs/strings"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "routing_sha256": {"$ref": "#/$defs/sha256"},
    "required_reference_ids": {"$ref": "#/$defs/strings"},
    "specialist_skills": {"$ref": "#/$defs/strings"},
    "selection": {"$ref": "#/$defs/selection"},
    "materialized_references": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/materializedReference"}
    },
    "issued_by": {"const": "agent-company-expertise-resolver/v0.2"},
    "issued_at": {"type": "string", "format": "date-time"},
    "attestation_scope": {"const": "resolver_materialized_selection"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "materializedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "ref", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "specialistDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id",
        "decision_question",
        "expected_marginal_value",
        "matched_triggers",
        "loading_cost"
      ],
      "properties": {
        "skill_id": {"type": "string", "minLength": 1},
        "decision_question": {"type": "string", "minLength": 1},
        "expected_marginal_value": {"type": "string", "minLength": 1},
        "matched_triggers": {"$ref": "#/$defs/strings"},
        "loading_cost": {"enum": ["small", "medium", "large"]}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_os_skill",
        "task_pack_id",
        "classification_basis",
        "matched_triggers",
        "ambiguous_task_types",
        "specialists"
      ],
      "properties": {
        "role_os_skill": {"type": "string", "minLength": 1},
        "task_pack_id": {"type": "string", "minLength": 1},
        "classification_basis": {
          "enum": ["explicit_hint", "trigger_match", "trigger_priority", "role_default"]
        },
        "matched_triggers": {"$ref": "#/$defs/strings"},
        "ambiguous_task_types": {"$ref": "#/$defs/strings"},
        "specialists": {
          "type": "array",
          "maxItems": 2,
          "items": {"$ref": "#/$defs/specialistDecision"}
        }
      }
    }
  }
}
