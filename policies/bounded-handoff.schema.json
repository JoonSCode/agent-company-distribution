      "properties": {
        "id": {"type": "string", "minLength": 1},
        "provenance": {"enum": ["direct", "reported"]},
        "claim_scope": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "ref_ids": {"$ref": "#/$defs/stringList"}
      }
    },
    "qaVerificationV02": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "candidate", "references", "criteria", "observations", "evidence_facts", "risk_boundary_matrix", "decisions", "blockers", "readiness"],
      "properties": {
        "format": {"const": "agent-company.qa-verification/v0.2"},
        "candidate": {"$ref": "#/$defs/qaCandidateV02"},
        "references": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/qaReferenceV02"}
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/qaCriterionV02"}
        },
        "observations": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/qaObservationV02"}
        },
        "evidence_facts": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/qaEvidenceFactV02"}
        },
        "risk_boundary_matrix": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion_id", "risk_id", "boundary_id", "impact", "non_substitute_surface"],
            "properties": {
              "criterion_id": {"type": "string", "minLength": 1},
              "risk_id": {"type": "string", "minLength": 1},
              "boundary_id": {"type": "string", "minLength": 1},
              "impact": {"enum": ["low", "medium", "high", "critical"]},
              "non_substitute_surface": {"type": "string", "minLength": 1}
            }
          }
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion_id", "status", "observation_ids"],
            "properties": {
              "criterion_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["passed", "failed", "blocked", "unverified"]},
              "observation_ids": {"$ref": "#/$defs/stringList"}
            }
          }
        },
        "blockers": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "criterion_id", "status", "owner", "next_check", "ref_ids"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "criterion_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["open", "resolved"]},
              "owner": {"type": "string", "minLength": 1},
              "next_check": {"type": "string", "minLength": 1},
              "ref_ids": {"$ref": "#/$defs/stringList"}
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "open_blocker_ids"],
          "properties": {
            "decision": {"enum": ["recommend", "reject"]},
            "open_blocker_ids": {"$ref": "#/$defs/stringList"}
          }
        }
      }
    },
    "knowledgeUsageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "receipt_id",
        "context_id",
        "role",
        "task_type",
