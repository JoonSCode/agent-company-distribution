        "context_id": {"$ref": "#/$defs/sha256"},
        "role": {"enum": ["founder", "planning", "marketing", "design", "development", "qa-release"]},
        "task_type": {"type": "string", "minLength": 1},
        "objective_sha256": {"$ref": "#/$defs/sha256"},
        "decision_questions": {"$ref": "#/$defs/stringList"},
        "registry_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "required_reference_ids": {"$ref": "#/$defs/stringList"},
        "used_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version", "ref", "sha256", "decisions_supported"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "ref": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"},
              "decisions_supported": {"$ref": "#/$defs/stringList"}
            }
          }
        },
        "unused_reference_ids": {"$ref": "#/$defs/stringList"},
        "specialist_skills": {"$ref": "#/$defs/stringList"},
        "reported_by": {"const": "role-worker"},
        "reported_at": {"type": "string", "format": "date-time"},
        "attestation_scope": {"const": "worker_reported_use_independent_verification_required"}
      }
    }
  }
