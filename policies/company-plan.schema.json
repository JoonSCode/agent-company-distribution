{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/company-plan.v0.2.json",
  "title": "Agent Company Company Plan",
  "description": "Planning-owned coordination graph. Uigwe owns material why/what/done, Sejong owns synthesis, and role plans own only local how.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "plan_id",
    "job_id",
    "objective",
    "material_ambiguity",
    "uigwe_binding",
    "milestones",
    "assignments",
    "company_success_criteria",
    "company_stop_criteria",
    "decision_register",
    "planning_deltas",
    "reentry_triggers",
    "sejong_synthesis_ref"
  ],
  "properties": {
    "format": {"const": "agent-company.company-plan/v0.2"},
    "plan_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "material_ambiguity": {"const": true},
    "uigwe_binding": {"$ref": "#/$defs/uigweBinding"},
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/milestone"}
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assignment"}
    },
    "company_success_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
    "company_stop_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
    "decision_register": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "planning_deltas": {
      "type": "array",
      "items": {"$ref": "#/$defs/planningDelta"}
    },
    "reentry_triggers": {"$ref": "#/$defs/nonEmptyStrings"},
    "sejong_synthesis_ref": {"$ref": "#/$defs/runtimeRef"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtimeRef": {
      "type": "string",
      "pattern": "^\\$\\{SEJONG_HOME\\}/runs/agent-company/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))[A-Za-z0-9._-]+/.+"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "uigweBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packet_ref", "packet_sha256", "decision_ref", "decision_sha256"],
      "properties": {
        "packet_ref": {"$ref": "#/$defs/runtimeRef"},
        "packet_sha256": {"$ref": "#/$defs/sha256"},
        "decision_ref": {"$ref": "#/$defs/runtimeRef"},
        "decision_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objective", "depends_on"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "objective": {"type": "string", "minLength": 1},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "leaf_id", "role", "objective", "read_scope", "write_scope", "outputs", "forbidden_mutations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "leaf_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["founder", "planning", "marketing", "design", "development", "qa-release"]},
        "objective": {"type": "string", "minLength": 1},
        "read_scope": {"$ref": "#/$defs/nonEmptyStrings"},
        "write_scope": {"$ref": "#/$defs/nonEmptyStrings"},
        "outputs": {"$ref": "#/$defs/nonEmptyStrings"},
        "forbidden_mutations": {"$ref": "#/$defs/nonEmptyStrings"},
        "acceptance_criteria": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary", "owner", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"enum": ["proposed", "approved", "rejected", "superseded"]},
        "summary": {"type": "string", "minLength": 1},
        "owner": {"enum": ["uigwe", "sejong", "planning"]},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/runtimeRef"}
        }
      }
    },
    "planningDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary", "changed_fields", "uigwe_reentry"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["schedule", "dependency", "material"]},
        "summary": {"type": "string", "minLength": 1},
        "changed_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!(?:assignments|outputs|read_scope|write_scope|forbidden_mutations|role|leaf_id|assignment_id)(?:\\.|\\[|$))(?!.*\\.(?:assignments|outputs|read_scope|write_scope|forbidden_mutations|role|leaf_id|assignment_id)(?:\\.|\\[|$))[A-Za-z_][A-Za-z0-9_-]*(?:\\[[0-9]+\\]|\\.[A-Za-z_][A-Za-z0-9_-]*)*$"
          }
        },
        "uigwe_reentry": {
          "oneOf": [
            {"$ref": "#/$defs/uigweBinding"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
