{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/reference-read-ledger.v0.1.json",
  "title": "Agent Company bounded reference read ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "ledger_id",
    "job_id",
    "role",
    "task_type",
    "context_id",
    "required_reference_ids",
    "used_reference_ids",
    "unused_reference_ids",
    "reads",
    "recorded_at"
  ],
  "properties": {
    "format": {"const": "agent-company.reference-read-ledger/v0.1"},
    "ledger_id": {"$ref": "#/$defs/sha256"},
    "job_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["founder", "planning", "marketing", "design", "development", "qa-release"]},
    "task_type": {"type": "string", "minLength": 1},
    "context_id": {"$ref": "#/$defs/sha256"},
    "required_reference_ids": {"$ref": "#/$defs/strings"},
    "used_reference_ids": {"$ref": "#/$defs/strings"},
    "unused_reference_ids": {"$ref": "#/$defs/strings"},
    "reads": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/read"}
    },
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_id",
        "layer",
        "source_ref",
        "sha256",
        "object_ref",
        "cache_status",
        "used"
      ],
      "properties": {
        "reference_id": {"type": "string", "minLength": 1},
        "layer": {"enum": ["role_kernel", "task_pack", "current_source_set", "job_evidence"]},
        "source_ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "object_ref": {"type": "string", "minLength": 1},
        "cache_status": {"enum": ["hit", "miss"]},
        "used": {"type": "boolean"}
      }
    }
  }
}
