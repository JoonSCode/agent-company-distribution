{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-company.local/schemas/model-profile-registry.v0.1.json",
  "title": "Agent Company Model Profile Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "rate_card_binding", "profiles"],
  "properties": {
    "format": {"const": "agent-company.model-profile-registry/v0.1"},
    "rate_card_binding": {"$ref": "#/$defs/binding"},
    "profiles": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/profile"}}
  },
  "$defs": {
    "binding": {"type": "object", "additionalProperties": false, "required": ["ref", "surface"], "properties": {"ref": {"const": "policies/model-rate-card.json"}, "surface": {"const": "standard_chatgpt_subscription_credit"}}},
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_profile", "model_id", "reasoning_effort", "authority", "dispatchable", "administrative_status", "runtime_availability_required", "service_tier_default", "speed_trait", "credit_trait", "allowed_task_types", "capability_rank", "capability_floor", "fallback_profile", "concurrency_cap", "rate_card_model_id"],
      "properties": {
        "semantic_profile": {"enum": ["mechanical", "standard-implementation", "bounded-deep", "integration", "specialist-reasoning", "role-lead-judgment", "company-judgment"]},
        "model_id": {"enum": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"]},
        "reasoning_effort": {"enum": ["medium", "high", "xhigh", "max"]},
        "authority": {"enum": ["executor", "role_lead", "company_root"]},
        "dispatchable": {"type": "boolean"},
        "administrative_status": {"enum": ["enabled", "disabled"]},
        "runtime_availability_required": {"const": true},
        "service_tier_default": {"const": "priority"},
        "speed_trait": {"enum": ["fast", "balanced", "deep"]},
        "credit_trait": {"enum": ["lowest", "moderate", "highest"]},
        "allowed_task_types": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "capability_rank": {"type": "integer", "minimum": 1, "maximum": 7},
        "capability_floor": {"type": "integer", "minimum": 1, "maximum": 7},
        "fallback_profile": {"type": ["string", "null"]},
        "concurrency_cap": {"type": "integer", "minimum": 1, "maximum": 8},
        "rate_card_model_id": {"enum": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"]}
      }
    }
  }
}
