  "adoptions": [
    {
      "source": "Orca upstream skill and bundled runtime documents",
      "disposition": "adapted",
      "reason": "Company owns portable operating policy while Orca retains current Task/Dispatch and lifecycle authority."
    },
    {
      "source": "Standalone public configuration contract",
      "disposition": "adopted",
      "reason": "User-supplied Markdown and explicit current-task choices govern model and service intent; no personal preferences or account history are distributed."
    },
    {
      "source": "Company evidence and independent acceptance contracts",
      "disposition": "adapted",
      "reason": "Preserve user authority, goal ownership, source provenance, independent verification and resource accounting without adding a scheduler or automatic paid fallback."
    },
    {
      "source": "Standalone transactional installation contract",
      "disposition": "adopted",
      "reason": "Require Company-owned source identity, integrity and ownership guards for install/update/recovery; preserve private user records and unrelated installations without external Core execution."
    },
    {
      "source": "Dots cloud improvement candidate and approved local brief constraints",
      "disposition": "adapted",
      "reason": "Bind integrated contribution/acceptance wording, permitted recovery alternatives and explicit constraints; preserve user authority, independent acceptance, and historical upstream hashes. Source checks do not certify live model or runtime outcomes."
    },
    {
      "source": "Approved Company P0/P1 evaluation and instruction simplification",
      "disposition": "adapted",
      "reason": "Freeze saved outcome inputs and reuse observed receipt fields through optional tools; preserve independent acceptance and original records, with no new execution engine or mandatory per-task ritual. Source consistency does not establish model quality or token savings."
    },
    {
      "source": "Approved company-next/r1 optional descriptive task set, saved Codex usage reader, and static status viewer",
      "disposition": "adapted",
      "reason": "Bind optional six-task outcome fixtures, single-turn captured Codex usage reader, and single-record static HTML/JSON status viewer with minimal discovery links; preserve upstream snapshots, independent acceptance, and no new mandatory workflow or runtime components. Source checks do not certify live provider quality, token savings, or installation state."
    },
    {
      "source": "Approved bounded provider-native helper workflow",
      "disposition": "adapted",
      "reason": "Make task-fit native contributions actionable inside the existing Orca owner through one work note, original-result integration and honest settings/resource settlement; preserve independent QA and no automatic Task/Dispatch bridge."
    }
  ],
  "verification_scope": "source identity and portable policy/tools; not a backend replacement or general runtime compatibility certification"
}
